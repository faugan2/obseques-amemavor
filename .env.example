# Copier ce fichier en .env.local et remplir avec la configuration Firebase
# (console Firebase > Paramètres du projet > Vos applications).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Espace de données utilisé :
#   demo -> données de démonstration (fictives)
#   reel -> données réelles des obsèques
# Les deux espaces sont séparés dans la base : espaces/demo/... et espaces/reel/...
VITE_ESPACE=demo
